# ============================================================
# Database
# ============================================================
# SQLite (default, zero-config for local dev):
DATABASE_URL=sqlite+aiosqlite:///./data/hkex_sync.db

# MySQL (for production):
# DATABASE_URL=mysql+asyncmy://root:root@localhost:3306/hkex_sync

# PostgreSQL (for production):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hkex_sync

# ============================================================
# Celery / Redis (optional)
# ============================================================
# Set to true when Redis is available. When false, sync tasks
# run directly in the API process (no Redis/Celery needed).
CELERY_ENABLED=false

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ============================================================
# Storage
# ============================================================
# Storage type: local or s3
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data/pdfs

# S3 config (only needed when STORAGE_BACKEND=s3)
S3_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
S3_BUCKET=hkex-pdfs
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=

# ============================================================
# Sync
# ============================================================
SYNC_STOCK_CODES=00700,09988
SYNC_CONCURRENCY=5
SYNC_CRON_SCHEDULE=0 * * * *

# ============================================================
# HKEX API (usually no need to change)
# ============================================================
HKEX_BASE_URL=https://www1.hkexnews.hk
HKEX_FULL_HISTORY_START=2000-01-01

# Default language for API responses when no language param is provided (en|zh|cn)
DEFAULT_LANGUAGE=en

# ============================================================
# HTTP Client
# ============================================================
HTTP_TIMEOUT=60
HTTP_MAX_RETRIES=3
HTTP_RETRY_BACKOFF=1.0

# ============================================================
# API
# ============================================================
API_PREFIX=/api
PAGE_SIZE_DEFAULT=20
PAGE_SIZE_MAX=100

# ============================================================
# Notification (optional)
# ============================================================
# Enable bot notifications for sync events
NOTIFIER_ENABLED=false
# Bot type: feishu (Lark), wecom (WeChat Work), dingtalk
NOTIFIER_TYPE=
# Send notification on sync completion
NOTIFIER_ON_SYNC=true
# Send notification when new announcements are synced
NOTIFIER_ON_NEW=true

# Feishu / Lark webhook config
NOTIFIER_FEISHU_WEBHOOK=
# Feishu sign secret (optional, leave empty if not configured in Feishu)
NOTIFIER_FEISHU_SECRET=

# Public URL of this service (used in notification card buttons)
SITE_URL=http://localhost:8000
